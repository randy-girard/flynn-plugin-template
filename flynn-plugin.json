{
  "name": "example",
  "kind": "app",
  "app": {
    "name": "example-plugin",
    "meta": {
      "flynn-system-app": "true",
      "flynn-plugin": "true"
    },
    "processes": {
      "web": {
        "args": ["/bin/start-flynn-example"],
        "ports": [
          {
            "port": 80,
            "proto": "tcp",
            "service": {
              "name": "example-plugin",
              "create": true,
              "check": {"type": "http", "path": "/ping"}
            }
          }
        ]
      }
    }
  },
  "inject_env": ["CONTROLLER_KEY", "SINGLETON"],
  "dashboard": {
    "base_url": "http://example-plugin.discoverd/dashboard",
    "surfaces": ["app.resources"],
    "card": {
      "title": "Example",
      "description": "Template plugin UI hosted by the dashboard",
      "icon": "plugin"
    },
    "routes": [
      {"path": "/", "title": "Overview"},
      {"path": "/metrics", "title": "Metrics"}
    ]
  },
  "cli": {
    "command": "example",
    "usage": "example Flynn plugin (template)",
    "subcommands": ["list", "help", "ping"],
    "doc": "usage: flynn example\n       flynn example:list\n       flynn example:help\n       flynn example ping\n\nexample:list is the same as flynn example. example:help is example --help.\n"
  },
  "hooks": {
    "install": "script/install.sh",
    "uninstall": "script/uninstall.sh"
  },
  "build": {
    "base": {
      "repo": "randy-girard/flynn",
      "version": "latest",
      "image": "ubuntu-noble"
    },
    "entrypoint": ["/bin/start-flynn-example"],
    "packages": "img/packages.sh",
    "go": {
      "./cmd/example": "/bin/example"
    },
    "copy": {
      "start.sh": "/bin/start-flynn-example"
    }
  },
  "artifacts": {
    "image": ""
  }
}
